{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewer exclusion of a vote or a voter (one line of votes/exclusions.jsonl)",
  "description": "Votes are never edited or deleted. A reviewer excludes a vote, or every vote from one account, by appending a line here with a recorded reason.",
  "type": "object",
  "required": ["reason", "by", "date"],
  "anyOf": [{"required": ["vote_id"]}, {"required": ["voter"]}],
  "properties": {
    "vote_id": {"type": "string", "pattern": "^CTG-VOTE-[0-9]{5,}$"},
    "voter": {"type": "string", "pattern": "^github:[a-z0-9][a-z0-9-]{0,38}$"},
    "reason": {"type": "string", "minLength": 1},
    "by": {"type": "string", "minLength": 1, "description": "Reviewer's GitHub login."},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  },
  "additionalProperties": false
}
